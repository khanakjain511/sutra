{
  "expo": {
    "name": "Attendance",
    "slug": "attendance",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#17171d",
    "ios": {
      "bundleIdentifier": "com.fieldguide.attendance"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attendance to scan your face for check-in.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar"
    ]
  }
}
